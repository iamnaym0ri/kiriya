# Copy the names below into Vercel → Project → Settings → Environment Variables.
# Mark every secret as "Sensitive". For local development, `npm run setup` writes .env.local for you.

SITE_URL=https://kiriya.love
KIRIYA_TZ=Asia/Singapore

# Passphrases, hashed. Prefer private input/output files:
# npm run hash -- --file .data/phrase.txt --output .data/passphrase.hash
KIRIYA_PASSPHRASE_HASH=
ADMIN_PASSPHRASE_HASH=
# Any long random string (e.g. `openssl rand -base64 32`). Changing it signs everyone out.
SESSION_SECRET=

# Neon: the existing kiriyaa integration supplies kData_DATABASE_URL in Production.
# Leave DATABASE_URL blank to use that connection. An explicit DATABASE_URL takes precedence.
DATABASE_URL=
# kData_DATABASE_URL= (managed by the existing Neon integration; do not copy it into client code)

# The existing private kiriya-blob connection supplies these automatically.
# Vercel manages VERCEL_OIDC_TOKEN itself; do not set a static copy.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Optional legacy alternative for a store authenticated with a static token.
# OIDC + both values above supports direct browser uploads without this token.
BLOB_READ_WRITE_TOKEN=

# Optional: Upstash QStash. Not needed for login, admin, drawing or uploads.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL= only if your QStash region needs it

# Vercel Cron backstop: any long random string. Vercel sends it automatically as a Bearer token.
CRON_SECRET=

# Web push. Generate once with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-email.com

# Feed foundation: live jobs stay off. Existing login/uploads do not require these.
FEEDS_ENABLED=false
# Local PGlite only; refused in Production/Preview or when DATABASE_URL is configured.
FEEDS_FIXTURE_MODE=false
OPENAI_API_KEY=
OPENAI_FEED_MODEL=gpt-5.6-luna
OPENAI_FEED_FALLBACK_MODEL=gpt-5.4-mini-2026-03-17
FEED_MONTHLY_BUDGET_USD=5
FEED_MAX_REQUESTS_PER_RUN=24
# Optional dated pricing overrides. Unknown model prices disable that paid path.
# FEED_MODEL_PRICES_JSON={"model-id":{"asOf":"YYYY-MM-DD","input":0.2,"cached":0.02,"cacheWrite":0.25,"output":1.2,"search":10000}}
# Later collectors (no routes or live schedules for them in this phase):
YOUTUBE_API_KEY=
TUMBLR_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
