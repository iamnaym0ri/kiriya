<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget key, for opening a note, pulling from the jar and "send one back" (KiriyaShared.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.love.kiriya.app</string>
	</array>
</dict>
</plist>
